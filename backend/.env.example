# Copy to .env. Never commit .env.
# Money is stored as integer cents (1 KES = 100). Do not use floats.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Required. Docker Compose overrides this to mongodb://mongo:27017/hifadhi
MONGODB_URI=mongodb://127.0.0.1:27017/hifadhi

LOG_LEVEL=info

# Comma-separated browser origins. Requests with no Origin (the mobile app, curl) are allowed.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Feature switches. Defaults shown below are the safe local settings.
# DEMO_MODE: 72-hour withdrawal delay becomes 20 seconds. Any 6-digit OTP is accepted.
DEMO_MODE=false
# MOCK_AI: rule-based agent, no Anthropic call.
MOCK_AI=true
# PAYOUT_PROVIDER: mock | minisend
PAYOUT_PROVIDER=mock
# SMS_PROVIDER: console | africastalking
SMS_PROVIDER=console
# X402_ENABLED: pay-per-decision calls to the agent service. Requires facilitator config.
X402_ENABLED=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
